# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD, ENCABEZADOS Y REDIRECCIÓN CANÓNICA - ABOGAR
# ==============================================================================

# Cabeceras de Seguridad y Confianza del Dominio (Security Headers)
<IfModule mod_headers.c>
  # 1. HSTS (HTTP Strict Transport Security): 1 año con subdominios y precarga
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

  # 2. Protección contra MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"

  # 3. Política de referidos segura
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 4. Protección contra Clickjacking / Iframes fraudulentos
  Header always set X-Frame-Options "SAMEORIGIN"

  # 5. Protección XSS heredada para navegadores antiguos
  Header always set X-XSS-Protection "1; mode=block"

  # 6. Política de Permisos del Navegador (Permissions Policy)
  Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=()"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Redirección 301 permanente a HTTPS seguro
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Redirección 301 canónica obligatoria: de www a sin-www (abogargroup.com)
  # Evita duplicidad de contenido y consolida la autoridad del dominio en Google
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 2.1. Redirección 301 canónica obligatoria: forzar barra final / para concordancia con etiquetas canónicas
  # Evita bucles de redirección con los buscadores al solicitar carpetas sin barra
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5}|/)$
  RewriteRule ^(.*)$ https://abogargroup.com/$1/ [R=301,L]

  # 3. Servir directamente archivos físicos existentes (imágenes, scripts, css, robots.txt, sitemap.xml)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Servir directorios físicos que contengan index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 5. Servir páginas pre-renderizadas específicas de rutas (con o sin barra final)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 6. Página de inicio raíz
  RewriteRule ^$ index.html [L]

  # 7. ELIMINACIÓN DEFINITIVA DEL PROBLEMA "SOFT 404":
  # Cualquier URL inexistente devolverá un código de estado HTTP 404 REAL a Googlebot
  # en lugar de responder falsamente con HTTP 200 OK.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# Servir la plantilla 404 personalizada con código de estado HTTP 404
ErrorDocument 404 /404.html

# Compresión Gzip / Deflate para optimizar velocidad de carga y Core Web Vitals
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Políticas de expiración y caché para recursos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
</IfModule>
